*.step filter=lfs diff=lfs merge=lfs -text
*.stp filter=lfs diff=lfs merge=lfs -text
*.3dm filter=lfs diff=lfs merge=lfs -text
# Linux実機(ROCK 5B / Raspberry Pi)へ配布して実行するファイルは、必ずLF改行で
# 作業ツリーに置く。core.autocrlf=true の環境ではチェックアウトのたびにCRLFへ
# 変換され、シェバングが "#!/bin/bash\r" になって
# 「sudo: unable to execute ...: No such file or directory」で起動不能になる
# （2026-09-01に実際に踏んだ。ファイルは存在するのにexecが失敗するため原因が
#   分かりにくい）。
*.sh text eol=lf
*.py text eol=lf
*.conf text eol=lf

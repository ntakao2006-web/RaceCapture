[Unit]
Description=Refresh EcoCapture containers after the boot router socket is created
After=docker.service arduino-router.service ecocapture-mcu-start.service
Requires=docker.service arduino-router.service
Wants=ecocapture-mcu-start.service

[Service]
Type=oneshot
# Runs only at boot and in the boot handshake recovery, before any recording starts.
# The web container did not stop on SIGTERM and was killed after docker's default
# 10 s on every boot (2026-10-20), so the wait is shortened to 2 s.
ExecStart=/usr/bin/docker restart -t 2 ecocapture-web ecocapture-viewer
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target

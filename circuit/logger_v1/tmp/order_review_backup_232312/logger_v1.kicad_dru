(version 1)

# JLCPCB rigid FR-4, 2-layer, 1 oz absolute manufacturing limits.
# Order assumptions: routed outline and green/red/yellow/blue/purple solder mask.

(rule "JLCPCB PTH annular ring"
    (constraint annular_width (min 0.18mm))
    (condition "A.Type == 'Pad' && A.isPlated()"))

(rule "JLCPCB via hole-to-track"
    (constraint hole_clearance (min 0.20mm))
    (condition "A.Type == 'Via' && B.Type == 'Track'"))

(rule "JLCPCB PTH hole-to-track"
    (constraint hole_clearance (min 0.28mm))
    (condition "A.Type == 'Pad' && A.isPlated() && B.Type == 'Track'"))

(rule "JLCPCB NPTH hole-to-track"
    (constraint physical_hole_clearance (min 0.20mm))
    (condition "A.Type == 'Pad' && !A.isPlated() && B.Type == 'Track'"))

(rule "JLCPCB via hole spacing"
    (constraint hole_to_hole (min 0.20mm))
    (condition "A.Type == 'Via' && B.Type == 'Via'"))

(rule "JLCPCB pad hole spacing"
    (constraint hole_to_hole (min 0.45mm))
    (condition "A.Type == 'Pad' && B.Type == 'Pad'"))

(rule "JLCPCB pad-to-silkscreen"
    (constraint silk_clearance (min 0.15mm))
    (condition "B.Type == 'Pad'"))

(rule "JLCPCB silkscreen-to-edge"
    (constraint silk_clearance (min 0.15mm))
    (condition "B.Layer == 'Edge.Cuts'"))

# Board Setup uses JLCPCB's 0.20 mm absolute NPTH-to-copper minimum. The
# stricter via/PTH/NPTH-to-track cases remain covered by the rules above.

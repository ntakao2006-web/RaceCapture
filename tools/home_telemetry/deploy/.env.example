# .env にコピーして書き換える（.env はGitに入れない）

# 外から見える名前（https:// と末尾の / は付けない）。Tailscale Funnelなら <マシン名>.<tailnet名>.ts.net
PUBLIC_HOST=logger.example.ts.net

# ecorun-logger-server の ECORUN_TELEMETRY_DIR の、ホスト側の場所。
# <dir>/<room>/<日時>Z.jsonl が並んでいるディレクトリ
TELEMETRY_DIR=/srv/ecorun-logger-server/data/telemetry

# Grafanaの管理者パスワード（初回起動時だけ効く。あとから変えるときはGrafanaの画面で）
GRAFANA_ADMIN_PASSWORD=change-me

# ホストの127.0.0.1に出すポート。5Bと同じ番号が既定。
# チームのcompose.yaml（logger-a/b）が3001・3002を使っているなら、空いている番号に変える
GRAFANA_PORT=3001
BRIDGE_PORT=3002

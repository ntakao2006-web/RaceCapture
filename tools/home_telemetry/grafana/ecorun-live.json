{
  "uid": "ecorun-live",
  "title": "EcoRun Live",
  "tags": [
    "ecorun"
  ],
  "timezone": "browser",
  "refresh": "500ms",
  "time": {
    "from": "now-5m",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "500ms",
      "1s",
      "2s",
      "5s",
      "10s"
    ]
  },
  "schemaVersion": 39,
  "templating": {
    "list": [
      {
        "name": "room",
        "label": "Room",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "ecorun-vm"
        },
        "query": {
          "query": "label_values(ecorun_Speed, room)",
          "refId": "room"
        },
        "definition": "label_values(ecorun_Speed, room)",
        "refresh": 2,
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Speed",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "ecorun-vm"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "ecorun_Speed{room=\"$room\"}",
          "legendFormat": "Speed"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "velocitykmh",
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "graphMode": "area",
        "colorMode": "none"
      },
      "interval": "100ms",
      "maxDataPoints": 3000
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Last data",
      "description": "Seconds since the last sample reached the server. Large = link down.",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "ecorun-vm"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - timestamp(ecorun_Speed{room=\"$room\"})",
          "legendFormat": "age",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 3
              },
              {
                "color": "red",
                "value": 10
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "graphMode": "none",
        "colorMode": "background"
      }
    },
    {
      "id": 3,
      "type": "geomap",
      "title": "Position",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 15
      },
      "datasource": {
        "type": "prometheus",
        "uid": "ecorun-vm"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "ecorun_Latitude{room=\"$room\"}",
          "format": "table",
          "range": true
        },
        {
          "refId": "B",
          "expr": "ecorun_Longitude{room=\"$room\"}",
          "format": "table",
          "range": true
        }
      ],
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "Time",
            "mode": "inner"
          }
        },
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "Value #A": "lat",
              "Value #B": "lon",
              "ecorun_Latitude": "lat",
              "ecorun_Longitude": "lon"
            }
          }
        }
      ],
      "options": {
        "view": {
          "id": "fit",
          "allLayers": true,
          "lastOnly": true,
          "zoom": 18,
          "padding": 0
        },
        "controls": {
          "showZoom": true,
          "mouseWheelZoom": true
        },
        "basemap": {
          "type": "esri-xyz",
          "name": "Aerial",
          "config": {
            "server": "world-imagery"
          }
        },
        "layers": [
          {
            "type": "route",
            "name": "Track",
            "location": {
              "mode": "coords",
              "latitude": "lat",
              "longitude": "lon"
            },
            "config": {
              "arrow": 1,
              "style": {
                "size": {
                  "fixed": 3
                },
                "color": {
                  "fixed": "yellow"
                },
                "opacity": 0.9
              }
            }
          }
        ]
      },
      "interval": "100ms",
      "maxDataPoints": 3000
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Speed",
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 10
      },
      "datasource": {
        "type": "prometheus",
        "uid": "ecorun-vm"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "ecorun_Speed{room=\"$room\"}",
          "legendFormat": "Speed"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "velocitykmh",
          "custom": {
            "lineWidth": 2,
            "spanNulls": 2000
          }
        },
        "overrides": []
      },
      "interval": "100ms",
      "maxDataPoints": 3000
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Acceleration",
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 24,
        "h": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "ecorun-vm"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "ecorun_LongAccel{room=\"$room\"}",
          "legendFormat": "Long"
        },
        {
          "refId": "B",
          "expr": "ecorun_LatAccel{room=\"$room\"}",
          "legendFormat": "Lat"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "spanNulls": 2000
          }
        },
        "overrides": []
      },
      "interval": "100ms",
      "maxDataPoints": 3000
    },
    {
      "id": 6,
      "type": "table",
      "title": "All channels (latest)",
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 24,
        "h": 10
      },
      "datasource": {
        "type": "prometheus",
        "uid": "ecorun-vm"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "last_over_time({__name__=~\"ecorun_.+\", room=\"$room\"}[1m])",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "room": true,
              "db": true
            }
          }
        }
      ]
    }
  ]
}
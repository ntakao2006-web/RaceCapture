[Unit]
Description=EcoLogger V2 onboard video with burned-in telemetry
After=docker.service ecocapture-web-start.service
[Service]
User=arduino
Environment=TZ=Asia/Tokyo
Environment=OVERLAY_SEGMENT_MIN=10
# 空きが1GiBを切ったら、ドラレコと同じく動画と走行記録をまとめて、①回収済み（PCで確かめた印のあるもの）②ほか、の順に
# 古いものから消して空け、録画を止めずに直近を残す。書いているファイル・記録中の走行記録・保護して回収していないものは消さず、
# 消せるものが無くなったときだけ止める（video_store.h、手順書5-17・5-18）。EcoCaptureも同じ1GiB・同じ順で消す
Environment=OVERLAY_MIN_FREE_MB=1024
# 1080p・10Mbps：空き約13GBで1回の電源ONあたり約2時間45分録れる（12Mbpsだと約2時間19分で、SUGO決勝120分の前後に余裕が無い）
Environment=OVERLAY_BITRATE_MBPS=10
ExecStart=/opt/ecologger-video/run-video.sh
# 電源を切るとき（SIGTERM）は、エンコーダに残った分を書き出してから終わる
TimeoutStopSec=10
Restart=on-failure
RestartSec=5
# 消せる動画が無く空きが足りずに止めたとき（終了コード3）は、その起動中はもう録らない
RestartPreventExitStatus=3
NoNewPrivileges=true
[Install]
WantedBy=multi-user.target
